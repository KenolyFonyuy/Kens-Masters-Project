{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05401", "label": "Frame 05401 - Overhead Broiler House CCTV, Gas Camera, 2022-02-23 11:05:06", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame05401.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Colour daytime still from a different camera, label '1080P-IPC-Gas', timestamp 2022-02-23 11:05:06. Young/small broilers on largely bare litter; four pan feeders on the feed pipe plus a red brooder/heater cone at upper right. Birds form a large loose clump above the feed line and tight rosettes at each pan, with much exposed floor elsewhere."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05401_gas_camera_view", "label": "Gas Camera Viewpoint (1080P-IPC-Gas)", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame05401.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Second named fixed overhead IP camera, watermark '1080P-IPC-Gas', source of frame 05401. Covers a different pen/zone with a visible brooder heater cone and younger birds."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05401_broiler_growth_stage_variation", "label": "Broiler Growth-Stage Variation Across Capture Dates", "file_type": "rationale", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame05401.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Apparent bird size increases markedly from 2022-02-23 and 2022-02-24 (small, well-separated birds, much bare litter) to 2022-03-01 (large birds covering the floor), reflecting broiler grow-out over roughly one week.", "rationale": "Sampling frames across grow-out dates makes the evaluation set cover a wide object-scale range, so a model cannot succeed by assuming a single bird size in pixels."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05401_huddling_clump_pattern", "label": "Off-Feeder Huddling Clump", "file_type": "rationale", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame05401.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Large loose aggregation of young birds away from the pan feeders in frame 05401, near the brooder heater cone rather than around feed.", "rationale": "Distinguishing a thermally driven huddle from a feeding rosette matters for welfare scoring: identical local density means opposite things depending on whether the cluster centre is a feeder or a heat source."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05401", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05401_gas_camera_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame05401.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05401", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame03901_pan_feeder_line", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame05401.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05401", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_