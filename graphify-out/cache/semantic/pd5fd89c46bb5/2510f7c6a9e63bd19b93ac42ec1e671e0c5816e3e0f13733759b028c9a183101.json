{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_siren_night_flock_frame", "label": "Siren-Channel Night Flock Frame (2022-03-14 22:13:13)", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01301.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overhead colour frame, '1080P-IPC-Siren', '2022-03-14 22:13:13' \u2014 six seconds after the other Siren frame of the same date. Same six feeders, same blue equipment at top edge; bird positions have shifted only slightly, so the pair captures short-interval motion."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_temporal_adjacent_frame_pair", "label": "Six-Second Temporally Adjacent Frame Pair", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01301.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two test frames from the same camera and date separated by ~6 s show a near-identical scene. Such pairs let displacement/activity be estimated between frames and also reveal near-duplicate leakage risk if test images were sampled from one continuous clip."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_timestamp_overlay_metadata", "label": "Burned-In Timestamp and Channel Overlay", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01301.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every frame carries a top-right date-time string and a top-left channel name rendered into the pixels. This supplies free per-image metadata (date, hour, camera) for stratifying results, but the bright text is also a fixed artefact that can bias models trained on raw crops."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_siren_night_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_siren_camera_channel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01301.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_siren_night_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_timestamp_overlay_metadata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01301.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_siren_night_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_temporal_adjacent_frame_pair", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01301.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01301_temporal_adjacent_frame_pair", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_siren_night_flock_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01301.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chick