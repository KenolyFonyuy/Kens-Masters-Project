{"nodes": [{"id": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_two_channel_relay_module", "label": "2-Channel Relay Module", "file_type": "image", "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Annotated product diagram of a blue/black 2-channel 5V relay board. Callouts label the two Songle relays, NO/COM/NC screw terminals for each channel, the GND/IN1/IN2/VCC control header, a second GND/VCC/JD-VCC header with power-select jumper, and the two relay-switch indicator LEDs."}, {"id": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_songle_srd_05vdc_sl_c_relay", "label": "Songle SRD-05VDC-SL-C Relay", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Two blue SONGLE SRD-05VDC-SL-C electromechanical relays, 5V DC coil, contacts rated 10A 250VAC / 10A 125VAC and 10A 30VDC / 10A 28VDC, CQC and UL marked."}, {"id": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_no_com_nc_terminals", "label": "NO / COM / NC Screw Terminals", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Per-channel three-way screw terminal block exposing Normally Open, Common and Normally Closed contacts, letting a load be wired to energise either on or off."}, {"id": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_in1_in2_control_inputs", "label": "IN1 / IN2 Control Inputs", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Logic-level header pins GND, IN1, IN2, VCC that accept the controller's digital output signals; each IN line drives one relay channel."}, {"id": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_jd_vcc_power_select_jumper", "label": "JD-VCC Power Select Jumper", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Jumper on the GND/VCC/JD-VCC header selecting whether the relay coil supply (JD-VCC) is bridged to the logic VCC or fed from a separate supply."}, {"id": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_optocoupler_isolation", "label": "Optocoupler Isolation of Control and Coil Supply", "file_type": "rationale", "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The board routes each IN line through an optocoupler and separates JD-VCC (coil power) from VCC (logic power) so that inductive kickback and coil inrush from switching mains loads never travels back into the controller's GPIO. Removing the power-select jumper and feeding JD-VCC externally gives true galvanic isolation; leaving it fitted trades that isolation for single-supply wiring simplicity."}, {"id": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_relay_switch_indicator_leds", "label": "Relay Switch Indicator LEDs", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "One LED per channel ('Relay switch 1/2 indicator') that lights when the corresponding relay is energised, giving at-a-glance confirmation of actuator state during commissioning and debugging."}, {"id": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_mains_load_switching", "label": "Mains AC Load Switching", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Switching of 230/250VAC mains loads at up to 10A through the relay contacts, which is what allows a 3.3V/5V logic controller to command grid-powered equipment."}], "edges": [{"source": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_two_channel_relay_module", "target": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_songle_srd_05vdc_sl_c_relay", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_location": null, "weight": 1.0}, {"source": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_two_channel_relay_module", "target": "poultry_system_component_images_poultry_system_component_images_05_2_channel_relay_module_no_com_nc_terminals", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry_system_component_images/poultry_system_component_images/05_2_channel_relay_module.jpg", "source_