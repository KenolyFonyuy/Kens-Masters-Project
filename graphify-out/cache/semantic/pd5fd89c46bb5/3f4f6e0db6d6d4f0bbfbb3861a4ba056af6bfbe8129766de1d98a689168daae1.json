{"nodes": [{"id": "poultry_system_component_images_poultry_system_component_images_components_contact_sheet_components_contact_sheet", "label": "Poultry System Components Contact Sheet", "file_type": "image", "source_file": "poultry_system_component_images/poultry_system_component_images/COMPONENTS_CONTACT_SHEET.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "A 2-column, 4-row captioned contact sheet tiling all eight system components with labels: DHT22 sensor, MQ135 gas sensor, Raspberry Pi 4, USB webcam, 2-channel relay, ventilation fan, infrared heat lamp, 5 V power supply. Functions as the visual bill of materials / figure plate for the build."}, {"id": "poultry_system_component_images_poultry_system_component_images_components_contact_sheet_dht22_sensor", "label": "DHT22 Temperature and Humidity Sensor", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/COMPONENTS_CONTACT_SHEET.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "AM2302/DHT22 module on a red breakout PCB with DAT, VCC and GND pins; supplies the temperature and relative-humidity readings for the house."}, {"id": "poultry_system_component_images_poultry_system_component_images_components_contact_sheet_mq135_gas_sensor", "label": "MQ135 Gas Sensor", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/COMPONENTS_CONTACT_SHEET.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Purple MQ135 breakout carrying a metal-mesh-capped gas-sensing element; detects ammonia, CO2 and other air-quality gases in the poultry house."}, {"id": "poultry_system_component_images_poultry_system_component_images_components_contact_sheet_raspberry_pi_4", "label": "Raspberry Pi 4 Model B", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/COMPONENTS_CONTACT_SHEET.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Raspberry Pi 4 Model B single-board computer showing the 40-pin GPIO header, USB-C power inlet, dual micro-HDMI, USB 2.0/3.0 ports and Ethernet; acts as the system controller hosting sensors, camera and relay outputs."}, {"id": "poultry_system_component_images_poultry_system_component_images_components_contact_sheet_poultry_house_monitoring_system", "label": "Poultry House Environmental Monitoring and Control System", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/COMPONENTS_CONTACT_SHEET.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The overall system these components constitute: a Raspberry Pi controller reading temperature/humidity, gas and video, and driving a ventilation fan and infrared heat lamp through a 2-channel relay to hold the house microclimate at set-point.", "rationale": "The parts list is deliberately built from low-cost, widely available hobbyist modules (Pi 4, DHT22, MQ135, USB webcam, 5V relay board) so the system is reproducible and repairable in a smallholder poultry context rather than dependent on proprietary farm controllers."}], "edges": [{"source": "poultry_system_component_images_poultry_system_component_images_components_contact_sheet_components_contact_sheet", "target": "poultry_system_component_images_poultry_system_component_images_components_contact_sheet_dht22_sensor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry_system_component_images/poultry_system_component_images/COMPONENTS_CONTACT_SHEET.jpg", "source_location": null, "weight": 1.0}, {"source": "poultry_system_component_images_poultry_system_compone