{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cows_livestock_tracking_demo", "label": "Livestock (Cattle) Multi-Object Tracking Demo (cows.gif)", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "77-frame 480x270 animated result GIF: a small herd of black and brown cattle on a coastal beach with cliffs and a village in the background. Each animal is enclosed in a green bounding box with a small class/ID caption and a green centroid dot; both standing and lying-down animals are tracked, including strongly overlapping and partially cropped individuals at the frame edge."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cows_animal_tracking_domain_transfer", "label": "Animal Tracking Domain Transfer", "file_type": "rationale", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retaining the cattle demo alongside the vehicle demo signals that the same centroid/IOU/Kalman association machinery transfers from rigid vehicles to deformable livestock. Animals break the constant-velocity, constant-appearance assumptions that vehicle tracking relies on - they change posture (standing vs lying), stop for long periods and overlap heavily - which is the closest available public analogue to a barn full of chickens."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cows_animal_tracking_domain_t