{"nodes": [{"id": "img_frame018011_pir_night_flock_frame", "label": "PIR Camera Night Flock Frame (2022-02-27 23:44:26)", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame018011.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Colour overhead still from the '1080P-IPC-PIR' channel at 2022-02-27 23:44:26, seventy-nine seconds after frame004011 from the same camera. The scene is identical in structure \u2014 same diagonal feed pipe, same five red-topped pans, same red bell drinker bottom-left, same glowing heater at the right \u2014 but individual birds have shifted position and the rosettes around the pans have thinned, showing measurable short-interval movement."}, {"id": "img_frame018011_temporal_frame_pair", "label": "Short-Interval Temporal Frame Pair", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame018011.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Two stills from the same camera separated by about 79 seconds (23:43:07 and 23:44:26 on 2022-02-27) with static equipment and shifted birds. Because everything except the animals is pixel-stable, differencing the pair isolates flock movement and gives a ready-made activity signal.", "rationale": "Extracting near-consecutive frames rather than isolated stills is what makes motion-based activity indices possible at all; with a fixed mount the background subtracts cleanly, so no registration step is needed and residual motion can be attributed directly to the birds."}], "edges": [{"source": "img_frame018011_pir_night_flock_frame", "target": "img_frame004011_pir_camera_channel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801