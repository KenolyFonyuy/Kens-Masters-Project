{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_1_gas_night_flock_frame", "label": "Gas-Channel Night Flock Frame (2022-03-14 22:25:08)", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01201 (1)(1).png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-down fixed CCTV still from a commercial broiler house, overlay '1080P-IPC-Gas' top-left and timestamp '2022-03-14 22:25:08' top-right. Near-grown white broilers cover essentially the whole litter floor; a horizontal suspended feed line with five red-topped pan feeders crosses the mid-frame. Serves as a hard test image for detection/counting: individual birds are heavily overlapping and the feeders are almost fully occluded by birds."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_1_peak_stocking_density", "label": "Peak Stocking Density / Full Floor Coverage", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01201 (1)(1).png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Late-cycle condition in which grown birds tile the visible floor with almost no exposed litter, so per-bird segmentation boundaries disappear. Density itself becomes the measurable behavioural signal (distribution uniformity) rather than individual tracks."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_1_white_bird_occlusion_challenge", "label": "White-on-Grey Occlusion and Low-Contrast Detection Challenge", "file_type": "rationale", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01201 (1)(1).png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All birds are near-identical white plumage on grey litter and touch or overlap each other, so colour and edge cues are weak. This is why such crowded frames are retained in the img_test set: they stress the detector's ability to separate adjacent instances rather than merely find birds."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_1_gas_camera_channel", "label": "1080P-IPC-Gas Camera Channel", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01201 (1)(1).png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One of two named 1080p IP-camera feeds burned into the overlay ('Gas'). The naming appears to identify the house/pen or the stimulus condition being monitored, giving each frame an implicit source-channel label usable for grouping or stratified evaluation."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_1_gas_night_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_1_gas_camera_channel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01201 (1)(1).png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_1_gas_night_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_1_peak_stocking_density", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01201 (1)(1).png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_