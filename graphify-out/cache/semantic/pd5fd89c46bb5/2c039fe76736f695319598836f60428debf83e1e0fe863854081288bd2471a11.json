{"nodes": [{"id": "poultry_monitoring_system_backend_templates_farms_breed_list_template", "label": "Breed List Template", "file_type": "code", "source_file": "poultry-monitoring-system/backend/templates/farms/breed_list.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_backend_templates_farms_breed_list_generic_list_scaffold", "label": "Generic Object List Scaffold", "file_type": "rationale", "source_file": "poultry-monitoring-system/backend/templates/farms/breed_list.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six list templates across farms and feeding (breed, customer, pen, supplier, feedtype, feedusage) are byte-identical: they derive the page heading from request.resolver_match.url_name with cut:'_list'|title, iterate the ListView-supplied object_list, render a generic Record/Created two-column table, and include partials/_pagination.html. The design intent is that a plain Django ListView needs no bespoke template - copying one neutral scaffold per model keeps template_name resolution conventional (app/model_list.html) while avoiding writing bespoke markup for low-value reference tables. The trade-off is duplicated files that must all be edited together, and a generic column set that cannot show model-specific fields."}], "edges": [{"source": "poultry_monitoring_system_backend_templates_farms_breed_list_template", "target": "poultry_monitoring_system_backend_templates_farms_breed_list_generic_list_scaffold", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/backend/templates/farms/breed_list.html", "source_location": null, "weight": 1.0}, {"source": "poultry_monitoring_system_backend_templates_farms_breed_list_template", "target": "poultry_monitoring_system_backend_templates_errors__error_body_empty_state_pattern", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/backend/templates/farms/breed_list.html", "source_location": null, "weight": 1.0}, {"source": "poultry_monitoring_system_backend_templates_farms_breed_list_template", "target": "poultry_monitoring_system_backend_templates_flocks_batch_list_server_side_get_filtering", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/backend/templates/farms/breed_list.html", "source_location": null, "weight": 1.0}, {"source": "poultry_monitoring_system_backend_templates_farms_breed_list_generic_list_scaffold", "target": "poultry_monitoring_system_backend_templates_farms_simple_form_generic_crud_form_scaffold", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "poultry-monitoring-system/backend/templates/farms/breed_list.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "generic_list_scaffold_family", "label": "Templates implementing the generic object-list scaffold", "nodes": ["poultry_monitoring_system_backend_templates_farms_breed_list_template", "poultry_monitoring_system_backend_templates_farms_customer_list_template", "poultry_monitoring_system_backend_templates_farms_pen_list_template", "poultry_monitoring_system_backend_templates_farms_supplier_list_template", "poultry_monitoring_system_backend_templates_feeding_feedtype_list_template", "poultry_monitoring_system_backend_templates_feeding_feedusage_list_template"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "poultry-monitoring-system/backend/templates/farms/breed_list.html"}]}