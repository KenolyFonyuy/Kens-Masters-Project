{"nodes": [{"id": "fig_2_1_heat_stress_in_poultry", "label": "Heat Stress in Poultry (Multi-Domain Impact Diagram)", "file_type": "image", "source_file": "fig 2.1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conceptual figure showing solar/thermal load falling on a chicken and radiating into four consequence domains (behavioral, physiological, neuroendocrine, production). It frames heat stress as a whole-bird syndrome rather than a single measurable variable, which motivates multi-modal sensing (temperature, humidity, behavior, acoustics) instead of a single thermometer."}, {"id": "fig_2_1_behavioral_changes", "label": "Behavioral Changes Under Heat Stress", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "top-left quadrant", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listed as: less time feeding, more time drinking, panting, less moving/walking, wings elevated. These are externally observable, which makes them the cheapest signals for camera/microphone-based detection."}, {"id": "fig_2_1_physiological_changes", "label": "Physiological Changes Under Heat Stress", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "bottom-left quadrant", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Oxidative stress, acid-base imbalance, respiratory alkalosis, increased H/L ratio, altered cecal microbial profile. These require invasive/lab sampling, so they are ground-truth references rather than deployable sensors."}, {"id": "fig_2_1_neuroendocrine_changes", "label": "Neuroendocrine Changes Under Heat Stress", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "top-right quadrant", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up: CRF, ACTH, catecholamines, plasma corticosterone. Down: T3, GnRH, FSH and LH. Shows the HPA axis activation plus reproductive-axis suppression that explains fertility and egg losses."}, {"id": "fig_2_1_production_changes", "label": "Production Changes Under Heat Stress", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "bottom-right quadrant", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Increased mortality, decreased feed intake, poor FCR, reduced body weight, lower meat quality, fewer/poorer eggs. This is the economic endpoint that justifies early-warning monitoring."}, {"id": "fig_2_1_panting", "label": "Panting (Thermoregulatory Behavior)", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "Behavioral Changes bullet 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaporative cooling response; it is the behavioral link to respiratory alkalosis and is acoustically and visually detectable."}, {"id": "fig_2_1_oxidative_stress", "label": "Oxidative Stress", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "Physiological Changes bullet 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fig_2_1_heterophil_lymphocyte_ratio", "label": "Heterophil/Lymphocyte (H/L) Ratio", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "Physiological Changes bullet 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Presented as a physiological stress index; used as an objective validation marker against which non-invasive stress proxies can be calibrated."}, {"id": "fig_2_1_plasma_corticosterone", "label": "Plasma Corticosterone Elevation", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "Neuroendocrine Changes bullet 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fig_2_1_reduced_feed_intake", "label": "Reduced Feed Intake", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "Production Changes bullet 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appears in both behavioral (spend less time feeding) and production (decreased feed intake) lists, making it the bridge between observable behavior and economic loss."}, {"id": "fig_2_1_increased_mortality", "label": "Increased Mortality", "file_type": "concept", "source_file": "fig 2.1.png", "source_location": "Production Changes bullet 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "fig_2_1_heat_stress_in_poultry", "target": "fig_2_1_behavioral_changes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.1.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_1_heat_stress_in_poultry", "target": "fig_2_1_physiological_changes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.1.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_1_heat_stress_in_poultry", "target": "fig_2_1_neuroendocrine_changes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.1.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_1_heat_stress_in_poultry", "target": "fig_2_1_production_changes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.1.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_1_behavioral_changes", "target": "fig_2_1_panting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.1.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_1_physiological_changes", "target": "fig_2_1_oxidative_stress", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.1.png", "source_loc