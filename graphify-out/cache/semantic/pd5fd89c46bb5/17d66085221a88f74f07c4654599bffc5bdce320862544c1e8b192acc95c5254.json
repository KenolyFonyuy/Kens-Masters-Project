{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_download_weights_pretrained_weight_download", "label": "Pretrained Weight Download Procedure", "file_type": "document", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/DOWNLOAD_WEIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights are fetched by shell scripts at setup time rather than committed to the repository, keeping the checkout small; the procedure assumes a POSIX shell (sudo chmod +x, ./get_*.sh), so it does not run as written on Windows."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_download_weights_yolov3_weights", "label": "YOLOv3 Pretrained Weights (get_yolo.sh)", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/DOWNLOAD_WEIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloaded into examples/pretrained_models/yolo_weights - note this path is under examples/, unlike the SSD models which live at the repository-root pretrained_models/, an inconsistency in the documented layout."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_download_weights_mobilenetssdv2_tensorflow_weights", "label": "TensorFlow MobileNetSSDv2 Weights (get_ssd_model.sh)", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/DOWNLOAD_WEIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_obj