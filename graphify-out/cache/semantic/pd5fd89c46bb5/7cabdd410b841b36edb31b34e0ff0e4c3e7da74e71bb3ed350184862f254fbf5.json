{"nodes": [{"id": "poultry_system_component_images_poultry_system_component_images_07_infrared_heat_lamp_infrared_heat_lamp", "label": "Infrared Ceramic Heat Lamp", "file_type": "image", "source_file": "poultry_system_component_images/poultry_system_component_images/07_infrared_heat_lamp.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Studio photograph on black of a white ceramic infrared heat emitter bulb with a spiral/concentric ridged emitting face and a metal Edison screw base; radiates heat without visible light."}, {"id": "poultry_system_component_images_poultry_system_component_images_07_infrared_heat_lamp_ceramic_heat_emitter", "label": "Ceramic Heat Emitter Element", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/07_infrared_heat_lamp.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Glazed ceramic face with an embedded resistive coil forming the concentric ridge pattern; converts electrical power to long-wave infrared radiation with no light output."}, {"id": "poultry_system_component_images_poultry_system_component_images_07_infrared_heat_lamp_e27_screw_base", "label": "E27 Screw Base", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/07_infrared_heat_lamp.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Standard Edison screw cap allowing the emitter to be installed in ordinary mains lamp holders, so the heater can be switched by an in-line relay contact."}, {"id": "poultry_system_component_images_poultry_system_component_images_07_infrared_heat_lamp_brooding_temperature_control", "label": "Brooding Temperature Control", "file_type": "rationale", "source_file": "poultry_system_component_images/poultry_system_component_ima