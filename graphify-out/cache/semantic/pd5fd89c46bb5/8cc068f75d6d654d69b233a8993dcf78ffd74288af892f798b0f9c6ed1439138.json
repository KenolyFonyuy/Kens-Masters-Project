{"nodes": [{"id": "img_frame01801_gas_mature_broiler_frame", "label": "Gas Camera Mature Broiler Frame (2022-03-14 22:25:42)", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Colour overhead still from the '1080P-IPC-Gas' channel at 2022-03-14 22:25:42, nineteen days after frame00501 from the same camera. The birds are now large, plump and heavily feathered, filling almost the entire floor with barely any visible litter between bodies. Five red-topped pan feeders remain on the same pipe but each bird now spans roughly the pan diameter, so only a handful of birds fit around each pan. Bodies overlap and merge visually."}, {"id": "img_frame01801_mature_broiler_stage", "label": "Late Grow-Out Stage (Large Birds, Mid-March)", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "By mid-March the same pen holds birds several times the pixel area they occupied in February, measured against the unchanged pan-feeder diameter. The feeder equipment acts as an in-frame scale reference that makes this growth directly quantifiable from the imagery alone."}, {"id": "img_frame01801_high_stocking_density", "label": "High Apparent Stocking Density and Occlusion", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "In the late-cycle frame adjacent birds touch and overlap so that the flock reads as a continuous white mass with only faint seams between individuals; the floor is almost fully covered. Individual instance boundaries are frequently indeterminate.", "rationale": "This is the hardest regime for the pipeline: bounding-box detection and identity tracking break down when instances merge, which pushes the analysis toward density estimation, segmentation or region-occupancy counting rather than per-bird detection for late-cycle footage."}], "edges": [{"source": "img_frame01801_gas_mature_broiler_frame", "target": "img_frame00501_gas_camera_channel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801.png", "source_location": null, "weight": 1.0}, {"source": "img_frame01801_gas_mature_broiler_frame", "target": "img_frame00501_pan_feeder_line", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801.png", "source_location": null, "weight": 1.0}, {"source": "img_frame01801_gas_mature_broiler_frame", "target": "img_frame01801_mature_broiler_stage", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801.png", "source_location": null, "weight": 1.0}, {"source": "img_frame01801_gas_mature_broiler_frame", "target": "img_frame01801_high_stocking_density", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801.png", "source_location": null, "weight": 1.0}, {"source": "img_frame01801_gas_mature_broiler_frame", "target": "img_frame00501_gas_daytime_flock_frame", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img/frame01801.png", "source_location": null, "weight": 1.0}, {"source": "img_frame01801_mature_broiler_stage", "targe