{"nodes": [{"id": "fig_2_3_smart_poultry_farm_architecture", "label": "Smart Poultry Farm System Architecture (Edge - Platform - Portals)", "file_type": "image", "source_file": "fig 2.3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-tier block diagram partitioning the system into an Edge Subsystem, a Digital Farming Platform and Portals. The split exists so that latency-sensitive and bandwidth-heavy vision work stays at the edge while aggregation, storage and user-facing logic live centrally; markers 1 and 2 highlight the AI-bearing blocks."}, {"id": "fig_2_3_edge_subsystem", "label": "Edge Subsystem", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "left dashed container", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fig_2_3_iot_nodes_with_sensors", "label": "IoT Nodes with Sensors (Microphone, Air Temp, Humidity, CO2, NH3, Light)", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Edge Subsystem, upper block", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sensor set chosen to cover the whole poultry-house microclimate: thermal comfort (temperature, humidity), air quality (CO2, NH3), lighting regime, and acoustics for vocalisation-based stress cues."}, {"id": "fig_2_3_smart_iot_camera_nodes", "label": "Smart IoT Camera Nodes", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Edge Subsystem, lower blue block (marker 1)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cameras are paired one-to-one with edge devices so inference happens next to the sensor; only results, not raw video, traverse the Ethernet/4G links."}, {"id": "fig_2_3_edge_device_ai_inference", "label": "Edge Device (AI/Inference)", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Edge Subsystem, marker 1 block", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fig_2_3_iot_edge_gateway", "label": "IoT Edge Gateway", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Edge Subsystem, centre", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single aggregation and protocol-translation point: it speaks BLE/LoRa/Ethernet downstream to heterogeneous nodes and 4G upstream, so the cloud sees one uniform stream and rural sites need only one WAN link."}, {"id": "fig_2_3_digital_farming_platform", "label": "Digital Farming Platform", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "centre dashed container", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fig_2_3_iot_platform", "label": "IoT Platform (Gateway, Sensor Data, Node Configuration, Security)", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Digital Farming Platform, left column", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fig_2_3_farm_management", "label": "Farm Management Services", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Digital Farming Platform, centre column", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundles incident detection, reporting, service book, admin, alert hub, map configuration, integration, environment monitoring, acoustic stress detection and food mix optimization into one service layer so analytics and workflow share the same sensor context."}, {"id": "fig_2_3_acoustic_stress_detection", "label": "Stress Detection (Acoustic)", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Farm Management, bottom-left tile", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio is used as a stress channel because vocalisation and panting sounds carry flock-level state at far lower bandwidth than video."}, {"id": "fig_2_3_dead_chicken_detection", "label": "Detection of Dead Chickens", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "marker 2 blue block", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fig_2_3_chicken_weight_estimation", "label": "Chicken Weight Estimation", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "marker 2 blue block", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vision-based weighing removes the handling stress and labour of manual weighing while giving continuous growth curves."}, {"id": "fig_2_3_environment_monitoring", "label": "Environment Monitoring Service", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Farm Management tile", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fig_2_3_data_storage", "label": "Data Storage (Blob Storage + SQL Database)", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Digital Farming Platform, right grey column", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polyglot persistence: blob storage for images/audio and a relational database for structured telemetry and farm records."}, {"id": "fig_2_3_api_and_app_logic_layer", "label": "User Portal App Logic / Web-Mobile API / 3rd-Party API", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "Digital Farming Platform, upper grey column", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit API tier decouples the portals from the platform internals and opens a third-party integration seam."}, {"id": "fig_2_3_portals", "label": "Portals (Command Center, Mobile Inspection App, Admin Portal)", "file_type": "concept", "source_file": "fig 2.3.png", "source_location": "right dashed container", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three distinct human roles get three distinct front ends: continuous supervision, in-house walk-around inspection, and system administration."}], "edges": [{"source": "fig_2_3_smart_poultry_farm_architecture", "target": "fig_2_3_edge_subsystem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.3.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_3_smart_poultry_farm_architecture", "target": "fig_2_3_digital_farming_platform", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.3.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_3_smart_poultry_farm_architecture", "target": "fig_2_3_portals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.3.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_3_edge_subsystem", "target": "fig_2_3_iot_nodes_with_sensors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.3.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_3_edge_subsystem", "target": "fig_2_3_smart_iot_camera_nodes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.3.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_3_edge_subsystem", "target": "fig_2_3_iot_edge_gateway", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.3.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_3_iot_nodes_with_sensors", "target": "fig_2_3_iot_edge_gateway", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.3.png", "source_location": "BLE / LoRa / Ethernet double arrow", "weight": 1.0}, {"source": "fig_2_3_smar