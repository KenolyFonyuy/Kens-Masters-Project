{"nodes": [{"id": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_usb_webcam", "label": "USB Webcam (Microsoft LifeCam HD)", "file_type": "image", "source_file": "poultry_system_component_images/poultry_system_component_images/04_USB_webcam.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Photograph of a black Microsoft-branded HD USB webcam with a cylindrical barrel body, glass lens behind a ribbed bezel, and a glowing blue status LED, clipped to the top bezel of a laptop/monitor. Serves as the vision input device of the poultry-house system."}, {"id": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_hd_video_capture", "label": "HD Video Capture", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/04_USB_webcam.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "High-definition video capture capability marked 'HD' on the camera bezel; provides the image stream used for visual inspection of birds."}, {"id": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_monitor_clip_mount", "label": "Monitor Clip Mount", "file_type": "concept", "source_file": "poultry_system_component_images/poultry_system_component_images/04_USB_webcam.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Hinged clip/foot on the underside of the camera that grips a display edge and lets the barrel tilt, allowing the camera to be aimed at a chosen field of view."}, {"id": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_visual_poultry_monitoring", "label": "Visual Poultry Monitoring", "file_type": "rationale", "source_file": "poultry_system_component_images/poultry_system_component_images/04_USB_webcam.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A commodity USB webcam is chosen over an industrial/CSI camera because it is low cost, UVC class-compliant (driverless on Linux/Raspberry Pi), and its clip-and-tilt mount lets the field of view be re-aimed without re-engineering a bracket. Video adds a behavioural/visual channel that scalar environmental sensors cannot provide."}], "edges": [{"source": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_usb_webcam", "target": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_hd_video_capture", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry_system_component_images/poultry_system_component_images/04_USB_webcam.jpg", "source_location": null, "weight": 1.0}, {"source": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_usb_webcam", "target": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_monitor_clip_mount", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry_system_component_images/poultry_system_component_images/04_USB_webcam.jpg", "source_location": null, "weight": 1.0}, {"source": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_visual_poultry_monitoring", "target": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_usb_webcam", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "poultry_system_component_images/poultry_system_component_images/04_USB_webcam.jpg", "source_location": null, "weight": 1.0}, {"source": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_monitor_clip_mount", "target": "poultry_system_component_images_poultry_system_component_images_04_usb_webcam_hd_video_ca