{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cars_vehicle_tracking_demo", "label": "Vehicle Multi-Object Tracking Demo (cars.gif)", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/examples/assets/cars.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "111-frame 480x270 animated result GIF used as the README demo for the multi-object-tracker package. Classic convertibles drive along a racetrack past a crash barrier; each vehicle carries a blue axis-aligned bounding box with a small green text label (class + numeric track ID) and a green centroid marker. Boxes follow individual cars as they approach, grow in scale and exit the frame, and distant cars near the horizon are also boxed."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cars_track_identity_persistence", "label": "Track Identity Persistence Across Frames", "file_type": "rationale", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/examples/assets/cars.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The GIF is the visual proof that tracking adds something detection alone cannot: a stable integer identity attached to each object across time. Per-frame detection would relabel each car every frame; the persistent ID is what makes downstream per-individual statistics (dwell time, trajectory, behaviour duration) possible at all. This is exactly the property the chicken-behaviour pipeline needs to attribute a behaviour episode to one bird."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cars_vehicle_tracking_demo", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cars_track_identity_persistence", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/examples/assets/cars.gif", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cars_vehicle_tracking_demo", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cows_livestock_tracking_demo", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/examples/assets/cars.gif", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cars_track_identity_persistence", "target": "figures_external_edge_ai_vision_pipeline_chicken_weight_estimation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/examples/assets/cars.gif", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "multi_object_tracker_demo_asset_set", "label": "Multi-Object Tracker Demo Assets Spanning Rigid and Deformable Domains", "nodes": ["chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_examples_assets_cars_vehicle_tracking_demo", "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_track