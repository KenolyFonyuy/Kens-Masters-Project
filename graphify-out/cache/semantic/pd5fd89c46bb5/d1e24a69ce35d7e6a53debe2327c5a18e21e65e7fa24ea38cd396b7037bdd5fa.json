{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901", "label": "Frame 04901 - Infrared Night-Vision Broiler House CCTV, Siren Camera, 2022-02-24 22:04:11", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame04901.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Monochrome infrared night-vision still from the Siren camera, timestamp 2022-02-24 22:04:11. Birds are noticeably smaller (earlier in the grow-out cycle) and far more dispersed than in the March colour frames. Same feed pipe and pan feeders, rendered without the red feeder caps because of the IR/greyscale sensor mode."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901_infrared_night_vision_mode", "label": "Infrared Night-Vision Capture Mode", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame04901.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Greyscale IR imaging mode the cameras switch into after dark (frames 04901 and 05601, both ~22:04). Removes colour cues such as the red feeder caps and lowers contrast between birds and litter.", "rationale": "Any detector trained on these frames must be colour-invariant, since the same scene appears in both RGB and monochrome IR depending on time of day - which is why both modalities are represented in the held-out img_test set."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901_nocturnal_resting_behavior", "label": "Nocturnal Resting / Low-Activity State", "file_type": "rationale", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame04901.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Night-time behavioural state inferred from the IR frames: birds are widely spread, largely stationary, and only lightly attending the feeders, in contrast to the compact feeder-centred crowding of the lit frames.", "rationale": "Comparing dispersion at the same clock hour across the flock cycle is a cheap proxy for disturbance/stress, so night frames are deliberately kept in the test set rather than discarded as low-quality."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame03901_siren_camera_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame04901.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901_infrared_night_vision_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame04901.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame03901_pan_feeder_line", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame04901.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame04901_nocturnal_resting_behav