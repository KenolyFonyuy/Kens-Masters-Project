{"nodes": [{"id": "figures_screenshots_web_charts_environment_monitoring_screen", "label": "Environmental Monitoring Screen", "file_type": "image", "source_file": "figures/screenshots/web_charts.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screenshot of the 'Environmental monitoring' page: a chart panel on top, a long 'Latest readings' table beneath it, pagination, and a warning callout at the bottom. Chart-above-detail-table layout lets a user spot a trend and then inspect the exact rows behind it on the same screen."}, {"id": "figures_screenshots_web_charts_temperature_time_series_chart", "label": "Temperature Time-Series Chart", "file_type": "concept", "source_file": "figures/screenshots/web_charts.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Line chart plotting the selected metric (temperature) over time with a legend swatch. In this capture the plot area is empty and the y-axis auto-scales to 0-1.0, i.e. the chart rendered with no series data even though the table below is full of readings - an apparent metric/series binding or aggregation-window mismatch worth flagging."}, {"id": "figures_screenshots_web_charts_latest_readings_table", "label": "Latest Sensor Readings Table", "file_type": "concept", "source_file": "figures/screenshots/web_charts.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hourly rows (June 25-27 2026) with columns Time, Device, Temp, Humidity, Gas risk, Quality. Temperature spans roughly 23-31 C and humidity roughly 49-72%, consistent with a tropical Yaounde broiler house sampled once per hour."}, {"id": "figures_screenshots_web_charts_gas_risk_index", "label": "Gas-Risk Index (Relative Ammonia Indicator)", "file_type": "rationale", "source_file": "figures/screenshots/web_charts.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit footer disclaimer: 'Gas readings are a relative ammonia-risk indicator, not a calibrated ppm measurement.' Design intent is honest instrumentation - a cheap uncalibrated MQ-series gas sensor is reported as a normalised 0-1 risk score with a '(high)' qualifier above threshold, rather than being dressed up as a scientific ppm value the hardware cannot deliver."}, {"id": "figures_screenshots_web_charts_reading_quality_flag", "label": "Reading Quality Flag", "file_type": "concept", "source_file": "figures/screenshots/web_charts.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each reading carries a quality label ('good') so downstream aggregates can exclude suspect samples; the dashboard's 24h average explicitly reports how many good-quality readings it was based on."}, {"id": "figures_screenshots_web_charts_demo_pi_001_device", "label": "Edge Device DEMO-PI-001", "file_type": "concept", "source_file": "figures/screenshots/web_charts.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single Raspberry-Pi-class sensor node identified as DEMO-PI-001 that authors every environmental reading in the table; naming implies a per-device provisioning scheme for the IoT tier."}, {"id": "figures_screenshots_web_charts_device_metric_selector", "label": "Device and Metric Selector", "file_type": "concept", "source_file": "figures/screenshots/web_charts.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two dropdowns ('All devices', 'Temperature') scope the chart and table together, so one page serves temperature, humidity and gas-risk views instead of three separate screens."}, {"id": "figures_screenshots_web_charts_readings_pagination", "label": "Readings Pagination Control", "file_type": "concept", "source_file": "figures/screenshots/web_charts.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previous / 'Page 1 of 2' / Next control caps the readings table at ~30 rows per page, bounding query cost on high-frequency time-series data."}], "edges": [{"source": "figures_screenshots_web_charts_environment_monitoring_screen", "target": "figures_screenshots_web_charts_temperature_time_series_chart", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/screenshots/web_charts.png", "source_location": null, "weight": 1.0}, {"source": "figures_screenshots_web_charts_environment_monitoring_screen", "target": "figures_screenshots_web_charts_latest_readings_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/screenshots/web_charts.png", "source_location": null, "weight": 1.0}, {"source": "figures_screenshots_web_charts_environment_monitoring_screen", "target": "figures_screenshots_web_charts_device_metric_selector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/screenshots/web_charts.png", "source_location": null, "weight": 1.0}, {"source": "figures_screenshots_web_charts_device_metric_selector", "target": "figures_screenshots_web_charts_temperature_time_series_chart", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "figures/screenshots/web_charts.png", "source_location": null, "weight": 1.0}, {"source": "figures_screenshots_web_charts_temperature_time_series_chart", "target": "figures_screenshots_web_charts_latest_readings_table", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "figures/screenshots/web_charts.png", "source_location": null, "weight": 1.0}, {"source": "figures_screenshots_web_charts_latest_readings_t