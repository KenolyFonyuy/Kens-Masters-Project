{"nodes": [{"id": "figures_generated_alert_state_diagram_alert_lifecycle", "label": "Alert Lifecycle State Machine", "file_type": "image", "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UML state machine with five states (NORMAL, WARNING, CRITICAL, ACKNOWLEDGED, RESOLVED). Escalation and de-escalation are modelled explicitly so an alert can worsen or improve without being recreated, preserving a single alert identity across its whole life."}, {"id": "figures_generated_alert_state_diagram_normal", "label": "NORMAL Alert State", "file_type": "concept", "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_generated_alert_state_diagram_warning", "label": "WARNING Alert State", "file_type": "concept", "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entered on threshold breach; exits either back to NORMAL when the condition clears with hysteresis, upward to CRITICAL when it worsens, or sideways to ACKNOWLEDGED on operator action."}, {"id": "figures_generated_alert_state_diagram_critical", "label": "CRITICAL Alert State", "file_type": "concept", "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_generated_alert_state_diagram_acknowledged", "label": "ACKNOWLEDGED Alert State", "file_type": "concept", "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acknowledgement is a distinct state rather than a boolean flag, so the system can distinguish 'a human has seen this' from 'the physical condition is fixed'."}, {"id": "figures_generated_alert_state_diagram_resolved", "label": "RESOLVED Alert State", "file_type": "concept", "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_generated_alert_state_diagram_hysteresis", "label": "Hysteresis Threshold Clearing", "file_type": "rationale", "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The WARNING to NORMAL transition is explicitly annotated 'clears (hysteresis)': the clear threshold is offset from the trip threshold so a sensor value oscillating around the limit does not produce a storm of alert/clear events. This is the diagram's main anti-flapping design decision."}], "edges": [{"source": "figures_generated_alert_state_diagram_alert_lifecycle", "target": "figures_generated_alert_state_diagram_normal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "weight": 1.0}, {"source": "figures_generated_alert_state_diagram_normal", "target": "figures_generated_alert_state_diagram_warning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "weight": 1.0}, {"source": "figures_generated_alert_state_diagram_warning", "target": "figures_generated_alert_state_diagram_normal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/generated/alert_state_diagram.pdf", "source_location": null, "weight": 1.0}, {"source": "figures_generated_alert_state_diagram_warning", "target": "figures_generated_alert_state_diagram_critical", "relati