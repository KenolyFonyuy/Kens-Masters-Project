{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_requirements_tracker_dependency_set", "label": "Multi-Object Tracker Dependency Set", "file_type": "document", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fully unpinned (numpy, scipy, matplotlib, opencv-contrib-python, pandas, motmetrics, setuptools, ipyfilechooser) - the opposite policy to the sibling yolo-v4-tf.keras requirements file, so the two vendored trees cannot be guaranteed to co-install cleanly. opencv-contrib-python here versus opencv-python there is a direct conflict: the two packages cannot both be installed."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_requirements_motmetrics", "label": "motmetrics Evaluation Dependency", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo-v4-tf.keras/multi-object-tracker/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "py-motmetrics is what makes the MOTA/MOTP evaluation harness possible; its presence in the runtime requirements (rather than a dev-extras file) means evaluation is treated as a first-class capability of the tracker package."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_requirements_tracker_dependency_set", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_multi_object_tracker_requirements_motmetrics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/yolo