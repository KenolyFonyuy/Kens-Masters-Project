{"nodes": [{"id": "poultry_monitoring_system_ml_configs_train_training_config", "label": "YOLO Training Configuration", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "whole file", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralises hyperparameters in one declarative file so Colab runs and local runs stay identical apart from path overrides."}, {"id": "poultry_monitoring_system_ml_configs_train_yolo11n_pt", "label": "yolo11n.pt Pretrained Weights", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightweight nano detector selected as the documented default, matching the edge-deployment constraint of the monitoring hardware."}, {"id": "poultry_monitoring_system_ml_configs_train_dataset_yaml", "label": "data/processed/dataset.yaml Dataset Manifest", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "data", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_train_conservative_augmentation", "label": "Conservative Biologically-Realistic Augmentation Policy", "file_type": "rationale", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "augment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Augmentation is deliberately restrained (limited rotation, limited scaling, moderate HSV) so synthetic images still depict postures a real bird can adopt; aggressive augmentation would teach the detector impossible poultry appearances and corrupt welfare-behaviour classes."}, {"id": "poultry_monitoring_system_ml_configs_train_no_vertical_flip", "label": "Vertical Flip Disabled (flipud = 0.0)", "file_type": "rationale", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "augment.flipud", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly never vertical-flip a bird: an upside-down bird is not a valid real-world observation, and inverting images would destroy the posture cues that distinguish healthy from lethargic or mobility-abnormal birds."}, {"id": "poultry_monitoring_system_ml_configs_train_horizontal_flip", "label": "Horizontal Flip Augmentation (fliplr = 0.5)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "augment.fliplr", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Left-right mirroring is retained because a bird facing either direction is equally plausible in a pen."}, {"id": "poultry_monitoring_system_ml_configs_train_early_stopping", "label": "Early Stopping (patience = 20)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "patience", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caps wasted Colab GPU time and guards against overfitting on a small labelled poultry dataset by stopping once validation stops improving for 20 epochs of the 100 budgeted."}, {"id": "poultry_monitoring_system_ml_configs_train_deterministic_seed", "label": "Deterministic Seed (seed = 42)", "file_type": "rationale", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "seed", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed seed makes runs reproducible 'where possible' \u2014 an explicit acknowledgement that GPU nondeterminism means bit-exact reproduction is not guaranteed, only approximate repeatability for the dissertation results."}, {"id": "poultry_monitoring_system_ml_configs_train_env_overrides", "label": "Environment Variable Path Overrides (DATASET_YAML, PROJECT_DIR)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "header comment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets the same committed config run unchanged in Colab where dataset and output paths differ, avoiding per-environment forks of the config file."}, {"id": "poultry_monitoring_system_ml_configs_train_mosaic_augmentation", "label": "Mosaic Augmentation (mosaic = 0.5)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "augment.mosaic", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_train_mixup_disabled", "label": "MixUp Disabled (mixup = 0.0)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "augment.mixup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blending two images would create ghosted, semi-transparent birds that no camera could observe, so mixup is switched off under the biological-realism constraint."}, {"id": "poultry_monitoring_system_ml_configs_train_broiler_yolo11n_run", "label": "broiler_yolo11n Training Run", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "name / project", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "poultry_monitoring_system_ml_configs_train_training_config", "target": "poultry_monitoring_system_ml_configs_train_yolo11n_pt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/ml/configs/train.yaml", "source_location": "model", "weight": 1.0}, {"source": "poultry_monitoring_system_ml_configs_train_training_config", "target": "pou