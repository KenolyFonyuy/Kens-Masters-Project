{"nodes": [{"id": "figures_generated_component_diagram_system_component_architecture", "label": "System Component Architecture", "file_type": "image", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-tier component view: an edge tier (sensing, Python runtime, inference, SQLite buffer, REST client), a server tier (Django REST API, farm management core, ORM layer, PostgreSQL) and a presentation tier (Bootstrap web UI). The REST boundary is the only coupling between edge and server."}, {"id": "figures_generated_component_diagram_sensing_and_actuation", "label": "Sensing & Actuation Component", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_generated_component_diagram_edge_runtime", "label": "Edge Runtime (Python service)", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single Python service orchestrates sensing, inference, buffering and upload, keeping the edge deployable as one process on constrained hardware."}, {"id": "figures_generated_component_diagram_inference_engine", "label": "Inference Engine (TFLite/ONNX)", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TFLite/ONNX rather than full TensorFlow or PyTorch at the edge: quantised runtimes fit the Raspberry Pi footprint and let the model be swapped without changing the host service."}, {"id": "figures_generated_component_diagram_local_buffer", "label": "Local Buffer (SQLite)", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An on-device SQLite store absorbs readings while connectivity is down, making the edge tolerant of intermittent rural networks; data is drained to the server by the REST client when the link returns."}, {"id": "figures_generated_component_diagram_rest_client", "label": "REST Client Component", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_generated_component_diagram_django_rest_api", "label": "Django REST API", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serves as the single ingress for both device telemetry and the web UI, so authentication and validation are implemented once."}, {"id": "figures_generated_component_diagram_farm_mgmt_core", "label": "Farm Mgmt Core (Django apps)", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_generated_component_diagram_orm_db_layer", "label": "ORM / DB Layer", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_generated_component_diagram_web_ui", "label": "Web UI (Bootstrap)", "file_type": "concept", "source_file": "figures/generated/component_diagram.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-rendered Bootstrap rather than an SPA framework, minimising client-side build tooling and keeping the dashb