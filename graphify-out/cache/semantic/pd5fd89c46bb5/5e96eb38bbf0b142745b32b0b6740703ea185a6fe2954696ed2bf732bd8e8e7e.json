{"nodes": [{"id": "figures_external_edge_ai_vision_pipeline_architecture_diagram", "label": "Edge AI Vision Pipeline Architecture Diagram", "file_type": "image", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Three-column block architecture diagram of a smart poultry-farm system, drawn with dashed swimlane boundaries labelled 'Edge Subsystem', 'Digital Farming Platform' and 'Portals'. Bidirectional arrows carry link-technology annotations (BLE / Lora / Ethernet, Ethernet, 4G). Two blue-shaded blocks with numbered navy callout badges (1 and 2) highlight the contributions of the work: the smart IoT camera nodes at the edge, and the dead-chicken-detection plus chicken-weight-estimation services on the platform."}, {"id": "figures_external_edge_ai_vision_pipeline_edge_subsystem", "label": "Edge Subsystem", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Leftmost dashed swimlane: everything physically inside the poultry house. Contains the sensor IoT nodes, the smart IoT camera nodes and the IoT edge gateway that aggregates them."}, {"id": "figures_external_edge_ai_vision_pipeline_iot_nodes_with_sensors", "label": "IoT Nodes with Sensors", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Vertical stack of in-house sensing modalities: microphone, air temperature, air humidity, CO2 level, NH3 (ammonia) level and light. These are the non-visual environmental channels that complement the camera stream."}, {"id": "figures_external_edge_ai_vision_pipeline_iot_edge_gateway", "label": "IoT Edge Gateway", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "On-farm router/gateway appliance. Speaks BLE, Lora and Ethernet down to the sensor nodes, Ethernet to the camera nodes, and 4G upstream to the cloud platform.", "rationale": "A single aggregation point lets the farm expose one managed uplink instead of many, and lets short-range low-power radios (BLE/Lora) be used for battery-powered sensors while the bandwidth-hungry camera nodes stay on wired Ethernet."}, {"id": "figures_external_edge_ai_vision_pipeline_smart_iot_camera_nodes", "label": "Smart IoT Camera Nodes", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Blue-shaded block carrying callout badge 1 - the first highlighted contribution. Each node pairs a camera with a co-located edge device, so vision capture and vision inference sit in the same physical unit inside the house."}, {"id": "figures_external_edge_ai_vision_pipeline_edge_device_ai_inference", "label": "Edge Device (AI / Inference)", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Accelerator/SoC drawn beside each camera, running the detection and estimation models locally.", "rationale": "Inference is placed at the edge rather than in the cloud because the uplink is 4G: continuously streaming raw video from every camera is infeasible on cost and bandwidth, and it also raises latency for time-critical alerts. Running the model on-node means only compact structured results (counts, boxes, weights, incident flags) traverse the link, which additionally limits how much raw imagery leaves the farm."}, {"id": "figures_external_edge_ai_vision_pipeline_4g_backhaul_link", "label": "4G Backhaul Link", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Bidirectional 4G arrow between the IoT edge gateway and the cloud IoT platform - the single constrained WAN hop of the whole architecture.", "rationale": "Cellular backhaul is chosen because poultry houses are typically rural with no reliable fixed line; its limited and metered bandwidth is the constraint that forces the edge-inference design decision."}, {"id": "figures_external_edge_ai_vision_pipeline_digital_farming_platform", "label": "Digital Farming Platform", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Central dashed swimlane hosting the cloud side: the IoT platform, the farm management service suite, the data storage tier and the portal/API application logic."}, {"id": "figures_external_edge_ai_vision_pipeline_iot_platform", "label": "IoT Platform", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Cloud-side ingestion column with four stacked capabilities: Gateway, Sensor Data, IoT Node Configurations and Security. It terminates the 4G link and mediates between devices and business services."}, {"id": "figures_external_edge_ai_vision_pipeline_sensor_data_store", "label": "Sensor Data", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Time-series telemetry repository inside the IoT platform holding the readings pushed up from the sensor IoT nodes."}, {"id": "figures_external_edge_ai_vision_pipeline_iot_node_configurations", "label": "IoT Node Configurations", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Device configuration/registry store, giving the downstream (cloud to device) direction of the bidirectional 4G arrow its purpose: remote provisioning and reconfiguration of edge nodes."}, {"id": "figures_external_edge_ai_vision_pipeline_farm_management", "label": "Farm Management Service Suite", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Central grid of ten business capabilities drawn as blue 'service' glyphs: incident detection, reporting, service book, admin, alert hub, map configuration, integration, environment monitoring, acoustic stress detection and food mix optimization - plus the two blue-shaded contributed services in the callout-2 block below it."}, {"id": "figures_external_edge_ai_vision_pipeline_incident_detection", "label": "Incident Detection", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Farm-management service that turns incoming sensor and vision events into flagged incidents requiring attention."}, {"id": "figures_external_edge_ai_vision_pipeline_alert_hub", "label": "Alert Hub", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Central notification fan-out service that routes detected incidents to the human-facing portals and mobile app."}, {"id": "figures_external_edge_ai_vision_pipeline_environment_monitoring", "label": "Environment Monitoring", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Service that tracks the in-house climate channels (temperature, humidity, CO2, NH3, light) against acceptable welfare ranges."}, {"id": "figures_external_edge_ai_vision_pipeline_stress_detection_acoustic", "label": "Stress Detection (Acoustic)", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Service that infers flock stress from vocalisation audio captured by the microphone sensor node - the non-visual counterpart to the camera-based welfare services.", "rationale": "Audio is used alongside vision because sound propagates through the whole house and is not blocked by occlusion or poor lighting, so it covers birds the cameras cannot see."}, {"id": "figures_external_edge_ai_vision_pipeline_detection_of_dead_chickens", "label": "Detection of Dead Chickens", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "One of the two blue-shaded services in the callout-2 block: computer-vision identification of mortality in the flock.", "rationale": "Marked as a contributed component. Automating mortality spotting replaces a manual walk-through inspection, so dead birds are removed sooner, which matters for both disease control and for keeping the recorded flock count accurate."}, {"id": "figures_external_edge_ai_vision_pipeline_chicken_weight_estimation", "label": "Chicken Weight Estimation", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Second blue-shaded service in the callout-2 block: vision-based estimation of live bird weight.", "rationale": "Marked as a contributed component. Camera-based weighing avoids the sampling bias of platform scales, which only ever weigh the subset of birds willing to step on them, and it is non-contact so it does not disturb the flock."}, {"id": "figures_external_edge_ai_vision_pipeline_food_mix_optimization", "label": "Food Mix Optimization", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Farm-management service that adjusts feed composition - the actuation-side consumer of growth and weight signals."}, {"id": "figures_external_edge_ai_vision_pipeline_data_storage", "label": "Data Storage Tier", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Grey block holding two complementary stores: Blob storage for unstructured payloads (images, audio clips) and a SQL database for structured records.", "rationale": "Split storage keeps large media out of the relational store: blobs hold the raw evidence frames while SQL holds the queryable events and metrics that portals report on."}, {"id": "figures_external_edge_ai_vision_pipeline_user_portal_app_logic", "label": "User Portal App Logic and APIs", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Grey block containing user portal app logic, a web/mobile API app and a third-party API surface. It is the single presentation/integration boundary between platform services and all external consumers."}, {"id": "figures_external_edge_ai_vision_pipeline_portals", "label": "Portals Swimlane", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Rightmost dashed swimlane holding the three human-facing clients, each connected to the API layer by its own bidirectional arrow."}, {"id": "figures_external_edge_ai_vision_pipeline_command_center_portal", "label": "Command Center Portal", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Desktop monitoring client (drawn as a monitor with a video play button), implying live camera review and centralised oversight of multiple houses."}, {"id": "figures_external_edge_ai_vision_pipeline_mobile_inspection_app", "label": "Mobile Inspection App", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Smartphone client for on-site staff, the natural delivery endpoint for alert-hub notifications while walking the house."}, {"id": "figures_external_edge_ai_vision_pipeline_admin_portal", "label": "Admin Portal", "file_type": "concept", "source_file": "figures/external/edge_ai_vision_pipeline.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Laptop/settings client for system administration - user management, node registration and platform configuration."}], "edges": [{"source": "figures_external_edge_ai_vision_pipeline_architecture_diagram", "target": "figures_external_edge_ai_vision_pipeline_edge_subsystem", "relation": "references", "co