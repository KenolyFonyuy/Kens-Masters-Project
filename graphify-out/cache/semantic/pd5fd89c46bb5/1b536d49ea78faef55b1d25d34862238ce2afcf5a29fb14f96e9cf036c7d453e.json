{"nodes": [{"id": "fig_2_5_yolo_unified_detection", "label": "YOLO Unified Object Detection Model", "file_type": "image", "source_file": "fig 2.5.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The canonical YOLO system diagram (dog/bicycle/car scene): the input is divided by an SxS grid, one branch predicts bounding boxes plus confidence, a parallel branch predicts a class probability map, and the two are combined into final detections. The design rationale is that detection is reframed as a single regression over the whole image, giving one-pass real-time inference instead of a region-proposal plus classification cascade."}, {"id": "fig_2_5_grid_cell_division", "label": "S x S Grid on Input", "file_type": "concept", "source_file": "fig 2.5.png", "source_location": "left panel", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each grid cell is made responsible for objects whose centre falls in it, which is what makes the number of predictions fixed and the network fully convolutional."}, {"id": "fig_2_5_bounding_box_confidence", "label": "Bounding Boxes + Confidence Prediction", "file_type": "concept", "source_file": "fig 2.5.png", "source_location": "upper-centre panel", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Box thickness in the figure encodes confidence; low-confidence boxes are later suppressed, which is the mechanism that turns a dense box field into a sparse detection set."}, {"id": "fig_2_5_class_probability_map", "label": "Class Probability Map", "file_type": "concept", "source_file": "fig 2.5.png", "source_location": "lower-centre panel", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-cell conditional class probabilities are predicted independently of the boxes and only multiplied in at the end, so the class head sees global image context."}, {"id": "fig_2_5_final_detections", "label": "Final Detections", "file_type": "concept", "source_file": "fig 2.5.png", "source_location": "right panel", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Result of combining box confidence with class probabilities and thresholding/NMS; the figure shows three surviving boxes (dog, bicycle, car)."}], "edges": [{"source": "fig_2_5_yolo_unified_detection", "target": "fig_2_5_grid_cell_division", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.5.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_5_yolo_unified_detection", "target": "fig_2_5_bounding_box_confidence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.5.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_5_yolo_unified_detection", "target": "fig_2_5_class_probability_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.5.png", "source_location": null, "weight": 1.0}, {"source": "fig_2_5_grid_cell_division", "target": "fig_2_5_bounding_box_confidence", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.5.png", "source_location": "upper split arrow", "weight": 1.0}, {"source": "fig_2_5_grid_cell_division", "target": "fig_2_5_class_probability_map", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.5.png", "source_location": "lower split arrow", "weight": 1.0}, {"source": "fig_2_5_bounding_box_confidence", "target": "fig_2_5_final_detections", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fig 2.5.png", "source_location": "upper merge arrow", "weight": 1.0}, {"source": "fig_2_5_class_probability_map", "target": "fig_2_5_final_detections", "relation": "shares_data_with", "confide