{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_tracking_demo", "label": "Cows Multi-Object Tracking Demo GIF", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Animated 480x270, 77-frame tracker result on a coastal beach scene: a small herd of black and brown cattle, some standing and some lying on the sand, beneath chalk cliffs and a cluster of white houses. Tracked animals carry lime-green bounding boxes with small ID labels and green centroid dots. Notably, several background cattle at the left remain untracked, so the clip also illustrates recall failure on distant/low-contrast animals.", "rationale": "Cattle are the demo closest to the chicken domain \u2014 deformable, same-coloured, partly stationary animals \u2014 and the visible misses on small background animals foreshadow exactly the recall problem a dense flock creates."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_livestock_tracking_use_case", "label": "Livestock Tracking Use Case", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Applying generic multi-object tracking to farm animals rather than vehicles or pedestrians: subjects are non-rigid, frequently stationary or lying down, visually near-identical to one another, and appear in unstructured outdoor or barn environments. Standing vs. lying posture is directly readable from box aspect ratio in this clip.", "rationale": "This is the demo that justifies adopting this tracker for a poultry project at all \u2014 it is evidence the association logic degrades gracefully on animals whose appearance features are weak and whose motion is intermittent."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_centroid_trajectory_marker", "label": "Centroid Marker as Trajectory Anchor", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Each tracked animal is reduced to a single green point drawn at the box centre; that point, not the full box, is the quantity carried forward by the motion model and logged as the object's per-frame position. Trajectories, speed and dwell-time statistics are all derived from this reduced representation.", "rationale": "Collapsing a deformable animal to one centroid keeps the state vector small and robust to box jitter caused by posture change, at the cost of losing size/orientation information that a behavior classifier might want."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_tracking_demo", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_livestock_tracking_use_case", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_tracking_demo", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_centroid_trajectory_marker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_tracking_demo", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cars_persistent_track_id_overlay", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_livestock_tracking_use_case", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05701_broiler_house_overhead_frame", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_centroid_trajectory_marker", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05701_pan_feeder_line", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_livestock_tracking_use_case", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_centroid_trajectory_marker", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "detect_then_track_visual_pipeline_evidence", "label": "Detect-Then-Track Pipeline Evidenced by Bundled Demo Assets", "nodes": ["chicken_behavior_analysis_main_chicken_behavior_analysis_main_yolo_v4_tf_keras_asset_pred_detection_output", "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cars_tracking_demo", "chicken_behavior_analysis_main_chicken_behavior_analysis_main_multi_object_tracker_examples_assets_cows_tracking_demo", "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame05701_broiler_house_overhead_frame"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/multi-object-tracker/examples/assets/cows.gif"}]}