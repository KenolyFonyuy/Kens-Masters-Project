{"nodes": [{"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_siren_infrared_flock_frame", "label": "Siren-Channel Infrared Night Frame (2022-02-24 22:00:59)", "file_type": "image", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01401.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Monochrome IR night-mode frame, '1080P-IPC-Siren', '2022-02-24 22:00:59'. Smaller younger birds are sparse on the litter and form clean radial rosettes around four pan feeders; a curtain/cable arc and vignetting are visible at the bottom. The cleanest frame for individual-bird detection in this chunk."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_infrared_night_vision_mode", "label": "Infrared Grayscale Night-Vision Mode", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01401.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The camera switches to single-channel IR when house lights are off, removing the red feeder cones and all colour cues and flattening bird-versus-litter contrast. A model must therefore generalise across colour and grayscale domains within the same nominal camera."}, {"id": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_feeder_ring_formation", "label": "Radial Ring Formation Around Feeder Pans", "file_type": "concept", "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01401.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At low stocking density the feeding posture resolves into a distinct spoke/rosette pattern of bodies radiating outward from each pan rim. This geometric template is countable (birds per pan) and is the low-density counterpart of the crowded arcs seen in later frames."}], "edges": [{"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_siren_infrared_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_infrared_night_vision_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01401.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_siren_infrared_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_feeder_ring_formation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01401.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_siren_infrared_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_1_siren_camera_channel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01401.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01401_siren_infrared_flock_frame", "target": "chicken_behavior_analysis_main_chicken_behavior_analysis_main_img_test_frame01201_pan_feeder_line", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Chicken-Behavior-Analysis-main/Chicken-Behavior-Analysis-main/img_test/frame01401.png", "source_location": null, "weight": 1.0}, {"source": "chicken_behavi