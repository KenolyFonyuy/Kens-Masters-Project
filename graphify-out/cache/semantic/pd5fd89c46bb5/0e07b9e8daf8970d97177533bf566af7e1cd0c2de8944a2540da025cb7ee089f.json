{"nodes": [{"id": "poultry_monitoring_system_backend_templates_flocks_batch_list_template", "label": "Batch List Template", "file_type": "code", "source_file": "poultry-monitoring-system/backend/templates/flocks/batch_list.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_backend_templates_flocks_batch_list_server_side_get_filtering", "label": "Server-Side GET Filtering and Search", "file_type": "rationale", "source_file": "poultry-monitoring-system/backend/templates/flocks/batch_list.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filtering is done with plain GET forms whose current state is re-read from request.GET (q, status, category) so the filtered view is bookmarkable and back-button safe. Select controls auto-submit via onchange=this.form.submit() to remove a click, which means the pattern degrades badly without JavaScript and fires a full page load per selection - accepted because the deployment target is low-spec browsers where server-rendered pages are cheaper than a client-side filter layer."}], "edges": [{"source": "poultry_monitoring_system_backend_templates_flocks_batch_list_template", "target": "poultry_monitoring_system_backend_templates_flocks_batch_detail_template", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/backend/templates/flocks/batch_list.html", "source_location": null, "weight": 1.0}, {"source": "poultry_monitoring_system_backend_templates_flocks_batch_list_template", "target": "poultry_monitoring_system_backend_templates_farms_farm_list_role_gated_action_visibility", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/backend/templates/flocks/batch_list.html", "source_location": null, "weight": 1.0}, {"source": "poultry_monitoring