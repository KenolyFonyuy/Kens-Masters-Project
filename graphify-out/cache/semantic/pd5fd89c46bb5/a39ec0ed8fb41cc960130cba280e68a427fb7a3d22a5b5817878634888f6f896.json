{"nodes": [{"id": "poultry_monitoring_system_backend_templates_inventory_item_list_template", "label": "Inventory Item List Template", "file_type": "code", "source_file": "poultry-monitoring-system/backend/templates/inventory/item_list.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_backend_templates_inventory_item_list_role_based_ui_gating", "label": "Role-Based UI Action Gating", "file_type": "rationale", "source_file": "poultry-monitoring-system/backend/templates/inventory/item_list.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutating actions (Add item, Stock movement, Edit, Register device, Save review) are wrapped in template-level checks on user.is_superuser and user.role against ADMIN/OWNER/MANAGER/VET. Inventory allows MANAGER while IoT device registration is restricted to ADMIN/OWNER only, and health review is gated to VET, encoding a per-domain privilege ladder. This is presentation-layer hiding only and must be mirrored by view-level permission checks to be a real control."}, {"id": "poultry_monitoring_system_backend_templates_inventory_item_list_low_stock_signal", "label": "Low Stock Reorder Signal", "file_type": "concept", "source_file": "poultry-monitoring-system/backend/templates/inventory/item_list.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "current_stock is compared against reorder_level via an is_low_stock property and surfaced as a Low/OK badge plus a '?low=1' filter link, so replenishment urgency is computed on the model and only displayed by the template."}], "edges": [{"source": "poultry_monitoring_system_backend_templates_inventory_item_list_template", "target": "poultry_monitoring_system_backend_templates_inventory_item_list_role_based_ui_gating", "relation": "implements", "confidence": "EX