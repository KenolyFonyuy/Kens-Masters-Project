{"nodes": [{"id": "poultry_monitoring_system_ml_configs_class_mapping_class_mapping", "label": "YOLO Class to Risk Category Mapping", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A configurable YAML mapping decouples the detector's class vocabulary from the web application's alert taxonomy, so risk categories, severities and alert types can be re-tuned without retraining or changing application code."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_yolo11n", "label": "yolo11n Detector (Configured Default Model)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "model.name", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as a lightweight nano detector to keep training reproducible and to allow deployment on edge hardware (Raspberry Pi class devices) rather than maximising raw accuracy."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_detect_task", "label": "Object Detection Task Setting", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "model.task", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_model_card", "label": "MODEL_CARD.md Trained Model Record", "file_type": "document", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "model.note", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The final trained model and its version are recorded in ml/models/MODEL_CARD.md after training on real data, so the config default is explicitly not the provenance record."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_healthy", "label": "healthy Class", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.healthy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps to the normal risk category with severity information and a null alert_type, so healthy detections are recorded but never raise an alert."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_lethargic", "label": "lethargic Class", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.lethargic", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_open_beak_stress", "label": "open_beak_stress Class", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.open_beak_stress", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open-beak posture is treated as a heat/respiratory distress indicator and is given its own warning-level alert type rather than being folded into a generic abnormality category."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_diseased_eye", "label": "diseased_eye Class", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.diseased_eye", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_slipped_tendon", "label": "slipped_tendon Class", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.slipped_tendon", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only class assigned critical severity, reflecting that a mobility abnormality is a welfare emergency requiring immediate stockperson intervention rather than routine monitoring."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_pendulous_crop", "label": "pendulous_crop Class", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.pendulous_crop", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_supplementary_classes", "label": "Supplementary (Not Yet Trainable) Classes", "file_type": "rationale", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "supplementary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented in the mapping so the alert taxonomy is complete and configurable, but explicitly excluded from training because no labelled data exists for them; enabling them without data would silently produce untrained, unreliable classes."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_huddling", "label": "huddling Class (Supplementary)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "supplementary.huddling", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_inactivity", "label": "inactivity Class (Supplementary)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "supplementary.inactivity", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_abnormal_gathering", "label": "abnormal_gathering Class (Supplementary)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "supplementary.abnormal_gathering", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_uncertain", "label": "uncertain Review Outcome", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "review_outcomes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately modelled as an inference/review OUTCOME rather than a trained class, so low-confidence detections route to human review instead of being predicted as a category the detector was never trained on."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_severity_scale", "label": "Alert Severity Scale (information | warning | critical)", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "header comment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity strings in this YAML must match apps.alerts.models.Severity exactly, making the config a shared contract between the ML pipeline and the Django alerts app."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_apps_alerts_models_severity", "label": "apps.alerts.models.Severity (Web Application Enum)", "file_type": "code", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "header comment", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_default_severity", "label": "default_severity Fallback", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "default_severity", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults to warning so a class that maps to an alert but omits severity still produces an actionable, non-silent alert rather than being dropped or escalated to critical."}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_risk_category_normal", "label": "normal Risk Category", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.healthy.risk_category", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_risk_category_inactive_or_lethargic", "label": "inactive_or_lethargic Risk Category", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "risk_category", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_risk_category_open_beak_distress", "label": "open_beak_distress Risk Category", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "risk_category", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_risk_category_visible_physical_abnormality", "label": "visible_physical_abnormality Risk Category", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "risk_category", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_risk_category_mobility_abnormality", "label": "mobility_abnormality Risk Category", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "risk_category", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_risk_category_huddling", "label": "huddling Risk Category", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "risk_category", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "poultry_monitoring_system_ml_configs_class_mapping_alert_type_contract", "label": "alert_type Web Application Contract", "file_type": "concept", "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "alert_type keys", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Risk categories are mapped onto alert types owned by the web application, so the detector never emits UI-facing alert names directly; a null alert_type is the explicit way to say 'detected but do not alert'."}], "edges": [{"source": "poultry_monitoring_system_ml_configs_class_mapping_class_mapping", "target": "poultry_monitoring_system_ml_configs_class_mapping_healthy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.healthy", "weight": 1.0}, {"source": "poultry_monitoring_system_ml_configs_class_mapping_class_mapping", "target": "poultry_monitoring_system_ml_configs_class_mapping_lethargic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.lethargic", "weight": 1.0}, {"source": "poultry_monitoring_system_ml_configs_class_mapping_class_mapping", "target": "poultry_monitoring_system_ml_configs_class_mapping_open_beak_stress", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "poultry-monitoring-system/ml/configs/class_mapping.yaml", "source_location": "class_mapping.open_beak_stress", "weight": 1.0}, {"source": "poultry_monitoring_system_ml_configs_class_mapping_class_mapping", 