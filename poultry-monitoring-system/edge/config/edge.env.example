# Edge client configuration. Copy to /etc/poultry-edge.env (chmod 600).
# NEVER commit the real token.
PMS_API_BASE=https://farm.example.com/api/v1
PMS_DEVICE_ID=PI-001
PMS_DEVICE_TOKEN=replace-with-token-issued-by-server
PMS_PEN_CODE=P1
PMS_BATCH_CODE=B1
PMS_MOCK=false
PMS_SAMPLING_INTERVAL=60
PMS_HEARTBEAT_INTERVAL=120
PMS_CAPTURE_INTERVAL=300
PMS_QUEUE_PATH=/var/lib/poultry-edge/queue.db
PMS_WEIGHTS=/opt/poultry-edge/models/best_ncnn_model
PMS_CONFIDENCE=0.35

# --- Hardware pin map (BCM numbering) ---------------------------------------
PMS_DHT_PIN=4
PMS_RELAY_FAN_PIN=17
PMS_RELAY_HEATER_PIN=27
PMS_RELAY_ACTIVE_LOW=true
PMS_RELAY_INTERLOCK=true
PMS_STATUS_LED_PIN=24

# --- Gas sensor -------------------------------------------------------------
# ads1115 | mcp3008 | dout. Only "dout" needs no ADC, and it yields a trip
# point rather than a magnitude — do not use it for reported measurements.
PMS_GAS_BACKEND=dout
PMS_GAS_DOUT_PIN=22
PMS_GAS_CHANNEL=0
PMS_GAS_DIVIDER_RATIO=2.0
PMS_GAS_WARMUP_SECONDS=180
# Per-sensor; produced by tools/05_mq135_baseline.py. Never copy between units.
PMS_GAS_BASELINE_V=0.4
PMS_GAS_SPAN_V=1.6

# --- Control law ------------------------------------------------------------
PMS_HYSTERESIS_C=1.0
PMS_MIN_ON_SECONDS=120
PMS_MIN_OFF_SECONDS=120
PMS_HUMIDITY_MAX_PCT=75.0
PMS_GAS_RISK_FAN_ON=0.8

# Set false until a camera is attached, or every cycle raises a capture failure.
PMS_VISION_ENABLED=false
