# Copy this file to backend/.env (for local dev) or set as real environment
# variables in production. NEVER commit a real .env file.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Douala

# --- Database ---
# Set DB_ENGINE=postgres to use PostgreSQL in development (recommended to match
# production). Leave as 'sqlite' for a quick local smoke test.
DB_ENGINE=sqlite
DB_NAME=poultry
DB_USER=poultry
DB_PASSWORD=poultry
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Production security (used by config.settings.prod) ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=2592000
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_LOG_FILE=/var/log/poultry/app.log
DJANGO_LOG_LEVEL=INFO

# --- Domain configuration ---
ALERT_COOLDOWN_MINUTES=30
DEVICE_OFFLINE_MINUTES=10
# ML_CLASS_MAPPING_PATH defaults to ../ml/configs/class_mapping.yaml

# --- API throttling rates ---
DRF_THROTTLE_DEVICE=120/minute
DRF_THROTTLE_CONFIG=60/minute
DRF_THROTTLE_USER=1000/hour
DRF_THROTTLE_ANON=30/hour
